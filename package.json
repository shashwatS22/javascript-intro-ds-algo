    "reset": "node runner/cli.js reset",
    "verify:readmes": "node scripts/verify-readmes.js",
    "test": "node --test runner/__tests__/**/*.test.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "picocolors": "^1.1.1"
  }
}
