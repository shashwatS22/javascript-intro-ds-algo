{
  "name": "monika-learning",
  "version": "1.0.0",
  "description": "Auto-graded JavaScript practice exercises",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node runner/watch.js",
    "check": "node runner/cli.js check",
    "check:level": "node runner/cli.js check:level",
    "progress": "node runner/cli.js progress",
